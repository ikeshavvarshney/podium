// podium - hackathon submission and judging platform
//
// Schema rationale lives in DATA-MODEL.md. The single most important decision
// here: participant / judge / admin are NOT columns on `users`. They are rows
// in `event_memberships`, so one account can be a participant in one event and
// a judge in another. Every event authorization check joins through that table.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Identity
// ============================================================

/// Global identity. Signed out is "Public", signed in is "User", and a user with
/// `isOrganizer` is an "Organizer". Carries exactly one global product capability
/// (`isOrganizer`, "may create events") plus an instance-operator flag.
/// Participant, judge and admin are never account labels; they are event roles.
model User {
  id           String  @id @default(uuid()) @db.Uuid
  email        String  @unique
  passwordHash String  @map("password_hash")
  name         String
  /// Global capability: may create events. Chosen at registration as
  /// "User" or "Organizer".
  isOrganizer  Boolean @default(false) @map("is_organizer")
  /// Instance operator, for platform maintenance. Not an event role.
  isSuperAdmin Boolean @default(false) @map("is_super_admin")

  pronouns  String?
  org       String?
  bio       String?
  link      String?
  avatarHue String  @default("slate") @map("avatar_hue")

  /// Bumped on password change or forced logout. Tokens carrying an older
  /// value are rejected, giving revocation without a session table.
  tokenVersion Int @default(0) @map("token_version")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships     EventMembership[]
  ownedEvents     Event[]           @relation("EventOwner")
  teamMemberships TeamMember[]
  createdInvites  TeamInvite[]      @relation("InviteCreator")
  assignments     JudgeAssignment[]
  scores          JudgeScore[]
  comments        Comment[]
  votes           Vote[]
  auditLogs       AuditLog[]        @relation("AuditActor")
  updatesAuthored EventUpdate[]     @relation("UpdateAuthor")
  signInTokens    SignInToken[]
  sessions        Session[]
  apiTokens       ApiToken[]
  uploads         Upload[]
  /// Notification preferences, keyed by kind. Read by the in-app notices.
  notificationPrefs Json @default("{}") @map("notification_prefs")
  pairwiseRankings PairwiseRanking[] @relation("PairwiseJudge")
  seekerListings   SeekerListing[]
  joinRequests     JoinRequest[]
  updateReads      UpdateRead[]
  registrations    Registration[]

  @@map("users")
}

/// One signed-in device. The JWT names its session, so a single device can be
/// revoked without signing the account out everywhere.
model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  userAgent  String?   @map("user_agent")
  ipHash     String?   @map("ip_hash")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  revokedAt  DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("sessions")
}

/// Single-use passwordless sign-in. Only the hash is stored, so a database
/// reader cannot mint a session, and a consumed or expired row is useless.
model SignInToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  ipHash    String?   @map("ip_hash")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("sign_in_tokens")
}

/// A bearer token for scripts and integrations. Only the hash is stored. A token scoped to an
/// event acts as its owner inside that event only, and as nobody anywhere else.
model ApiToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  eventId    String?   @map("event_id") @db.Uuid
  name       String
  tokenHash  String    @unique @map("token_hash")
  /// First characters of the token, so an owner can tell tokens apart.
  prefix     String
  expiresAt  DateTime? @map("expires_at")
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_tokens")
}

/// Rate-limit windows shared across API replicas, used when RATE_LIMIT_STORE=postgres.
model RateLimitBucket {
  key     String   @id
  count   Int
  resetAt DateTime @map("reset_at")

  @@index([resetAt])
  @@map("rate_limit_buckets")
}

/// An uploaded image, kept in the database so a deployment needs no object storage and backups
/// and event exports carry the images with everything else. Small by rule (2 MB, raster only).
model Upload {
  id          String   @id @default(uuid()) @db.Uuid
  ownerId     String   @map("owner_id") @db.Uuid
  eventId     String?  @map("event_id") @db.Uuid
  contentType String   @map("content_type")
  size        Int
  sha256      String
  data        Bytes
  createdAt   DateTime @default(now()) @map("created_at")

  owner User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  event Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([ownerId, createdAt])
  @@index([eventId])
  @@map("uploads")
}

/// Secrets generated on first boot, so no instance runs on a default from the repository.
model InstanceSecret {
  name      String   @id
  value     String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("instance_secrets")
}

// ============================================================
// Events and event-scoped membership
// ============================================================

enum EventStatus {
  DRAFT
  PUBLISHED
  REGISTRATION_OPEN
  SUBMISSIONS_OPEN
  JUDGING
  VOTING
  RESULTS_PUBLISHED
  ARCHIVED
}

/// How the event is run. Shown on the gallery and filterable on discover.
enum EventMode {
  ONLINE
  IN_PERSON
  HYBRID
}

enum EventVisibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

model Event {
  id          String          @id @default(uuid()) @db.Uuid
  slug        String          @unique
  name        String
  tagline     String?
  description String?
  themeTags   String[]        @default([]) @map("theme_tags")
  /// A square logo and a wide banner, both links to uploaded images.
  logoUrl     String?         @map("logo_url")
  bannerUrl   String?         @map("banner_url")
  /// Which standard registration fields are required, optional or not asked, keyed by field.
  registrationFields Json     @default("{}") @map("registration_fields")
  status      EventStatus     @default(DRAFT)
  visibility  EventVisibility @default(PUBLIC)

  ownerId String @map("owner_id") @db.Uuid
  owner   User   @relation("EventOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  // Timeline. All deadline enforcement reads these columns server-side; the
  // client clock is never trusted.
  registrationOpensAt  DateTime? @map("registration_opens_at")
  registrationClosesAt DateTime? @map("registration_closes_at")
  submissionsOpenAt    DateTime? @map("submissions_open_at")
  submissionDeadline   DateTime? @map("submission_deadline")
  judgingOpensAt       DateTime? @map("judging_opens_at")
  judgingClosesAt      DateTime? @map("judging_closes_at")
  votingOpensAt        DateTime? @map("voting_opens_at")
  votingClosesAt       DateTime? @map("voting_closes_at")

  mode        EventMode @default(HYBRID)
  /// Where it happens, when it is not purely online.
  place       String?

  timezone    String @default("UTC")
  minTeamSize Int    @default(1) @map("min_team_size")
  maxTeamSize Int    @default(4) @map("max_team_size")
  eligibility String @default("All")

  /// How many independent judge evaluations each submission needs.
  reviewsPerSubmission Int @default(3) @map("reviews_per_submission")

  /// Results stay organizer-only until this flips.
  resultsPublished   Boolean   @default(false) @map("results_published")
  resultsPublishedAt DateTime? @map("results_published_at")
  /// The run the public sees, pinned at publication.
  publishedRunId     String?   @unique @map("published_run_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships       EventMembership[]
  tracks            Track[]
  rounds            Round[]
  faq               FaqItem[]
  people            EventPerson[]
  partners          Partner[]
  challenges        Challenge[]
  prizes            Prize[]
  teams             Team[]
  submissions       Submission[]
  rubric            Rubric?
  customQuestions   CustomQuestion[]
  assignments       JudgeAssignment[]
  scores            JudgeScore[]
  normalizationRuns NormalizationRun[]
  publishedRun      NormalizationRun? @relation("PublishedRun", fields: [publishedRunId], references: [id], onDelete: SetNull)
  apiTokens         ApiToken[]
  uploads           Upload[]
  pairwiseRankings  PairwiseRanking[]
  webhooks          Webhook[]
  seekerListings    SeekerListing[]
  joinRequests      JoinRequest[]
  registrations     Registration[]
  votingConfig      VotingConfig?
  voterVerifications VoterVerification[]
  votes             Vote[]
  comments          Comment[]
  updates           EventUpdate[]
  auditLogs         AuditLog[]

  @@index([status, visibility])
  @@map("events")
}

/// The authorization spine. A user's capabilities inside an event come from
/// here and nowhere else. A user is never a participant, judge or admin in
/// general, only in a particular event.
enum EventRole {
  PARTICIPANT
  JUDGE
  ADMIN
}

model EventMembership {
  id      String    @id @default(uuid()) @db.Uuid
  eventId String    @map("event_id") @db.Uuid
  userId  String    @map("user_id") @db.Uuid
  role    EventRole

  /// A judge restricted to these track ids sees nothing outside them. Empty
  /// means "every track in this event".
  trackScope String[] @default([]) @map("track_scope")

  invitedById String?   @map("invited_by_id") @db.Uuid
  acceptedAt  DateTime? @map("accepted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// One row per (event, user, role). A user may hold several roles in one
  /// event (an admin who also judges), but never the same one twice.
  @@unique([eventId, userId, role])
  @@index([userId])
  @@index([eventId, role])
  @@map("event_memberships")
}

enum RoundKind {
  QUIZ
  SUBMISSION
  SCORING
  PITCH
  VOTE
  RESULT
}

/// A judging round. Events that cut the field run several; most run one.
/// Rounds are descriptive scheduling, not a second authorization surface:
/// what a judge may read still comes from their assignments.
model Round {
  id          String    @id @default(uuid()) @db.Uuid
  eventId     String    @map("event_id") @db.Uuid
  name        String
  kind        RoundKind @default(SCORING)
  description String?
  position    Int       @default(0)
  opensAt     DateTime? @map("opens_at")
  closesAt    DateTime? @map("closes_at")
  /// How many projects carry into the next round. Null means "all of them".
  advances    Int?

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, position])
  @@map("rounds")
}

/// Organizer-written answers shown on the event page.
model FaqItem {
  id       String @id @default(uuid()) @db.Uuid
  eventId  String @map("event_id") @db.Uuid
  question String
  answer   String
  position Int    @default(0)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, position])
  @@map("faq_items")
}

enum PersonKind {
  SPEAKER
  MENTOR
}

/// A speaker or mentor listed on the event's People tab. Purely informational:
/// carries no account, no login, no capability.
model EventPerson {
  id       String     @id @default(uuid()) @db.Uuid
  eventId  String     @map("event_id") @db.Uuid
  kind     PersonKind @default(MENTOR)
  name     String
  role     String
  org      String?
  position Int        @default(0)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, position])
  @@map("event_people")
}

/// A sponsor or partner organization, listed on the event's People tab.
model Partner {
  id       String @id @default(uuid()) @db.Uuid
  eventId  String @map("event_id") @db.Uuid
  name     String
  tier     String
  position Int    @default(0)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, position])
  @@map("partners")
}

/// A sponsor-funded prize track. A team opts a submission in from the submit
/// form; "entries" is the live count of submissions carrying this id.
model Challenge {
  id          String   @id @default(uuid()) @db.Uuid
  eventId     String   @map("event_id") @db.Uuid
  sponsor     String
  name        String
  brief       String
  amountCents Int?     @map("amount_cents")
  currency    String   @default("USD")
  tags        String[] @default([])
  position    Int      @default(0)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, position])
  @@map("challenges")
}

model Track {
  id          String  @id @default(uuid()) @db.Uuid
  eventId     String  @map("event_id") @db.Uuid
  name        String
  slug        String
  description String?
  /// Restricted tracks require an explicit judge track scope to be readable.
  restricted  Boolean @default(false)
  position    Int     @default(0)

  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  submissions Submission[]
  prizes      Prize[]

  @@unique([eventId, slug])
  @@map("tracks")
}

model Prize {
  id          String  @id @default(uuid()) @db.Uuid
  eventId     String  @map("event_id") @db.Uuid
  trackId     String? @map("track_id") @db.Uuid
  title       String
  description String?
  amountCents Int?    @map("amount_cents")
  currency    String  @default("USD")
  quantity    Int     @default(1)
  position    Int     @default(0)

  event Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  track Track? @relation(fields: [trackId], references: [id], onDelete: SetNull)

  @@map("prizes")
}

// ============================================================
// Teams
// ============================================================

model Team {
  id                String  @id @default(uuid()) @db.Uuid
  eventId           String  @map("event_id") @db.Uuid
  name              String
  pitch             String?
  lookingForMembers Boolean @default(false) @map("looking_for_members")
  /// Board listing: the track the team is aiming at, roles it still needs,
  /// and the stack it works in.
  boardTrackId      String?  @map("board_track_id") @db.Uuid
  needs             String[] @default([])
  skills            String[] @default([])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  event        Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  members      TeamMember[]
  invites      TeamInvite[]
  submission   Submission?
  joinRequests JoinRequest[]

  @@unique([eventId, name])
  @@map("teams")
}

/// A person without a team, listed on the board. One per person per event.
model SeekerListing {
  id        String   @id @default(uuid()) @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  pitch     String
  skills    String[] @default([])
  trackId   String?  @map("track_id") @db.Uuid
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@map("seeker_listings")
}

enum JoinDirection {
  /// A person asks a team to take them.
  ASK
  /// A team owner invites a person.
  INVITE
}

enum JoinStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
}

/// A private request between a team and a person. Nothing changes on either
/// side until the counterparty accepts.
model JoinRequest {
  id        String        @id @default(uuid()) @db.Uuid
  eventId   String        @map("event_id") @db.Uuid
  teamId    String        @map("team_id") @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  direction JoinDirection
  status    JoinStatus    @default(PENDING)
  message   String?
  createdAt DateTime      @default(now()) @map("created_at")
  decidedAt DateTime?     @map("decided_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  team  Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([eventId, userId])
  @@index([teamId, status])
  @@map("join_requests")
}

enum TeamRole {
  OWNER
  MEMBER
}

model TeamMember {
  id     String   @id @default(uuid()) @db.Uuid
  teamId String   @map("team_id") @db.Uuid
  userId String   @map("user_id") @db.Uuid
  role   TeamRole @default(MEMBER)

  joinedAt DateTime @default(now()) @map("joined_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

/// Invite links. Only a hash of the token is stored; the plaintext is shown
/// once to the creator and never persisted.
model TeamInvite {
  id          String    @id @default(uuid()) @db.Uuid
  teamId      String    @map("team_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash")
  createdById String    @map("created_by_id") @db.Uuid
  maxUses     Int?      @map("max_uses")
  useCount    Int       @default(0) @map("use_count")
  expiresAt   DateTime? @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  team      Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy User @relation("InviteCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@map("team_invites")
}

// ============================================================
// Submissions
// ============================================================

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  WITHDRAWN
  DISQUALIFIED
}

model Submission {
  id      String  @id @default(uuid()) @db.Uuid
  eventId String  @map("event_id") @db.Uuid
  teamId  String  @unique @map("team_id") @db.Uuid
  trackId String? @map("track_id") @db.Uuid

  name         String
  tagline      String?
  description  String?
  thumbnailUrl String?  @map("thumbnail_url")
  repoUrl      String?  @map("repo_url")
  liveUrl      String?  @map("live_url")
  videoUrl     String?  @map("video_url")
  techTags     String[] @default([]) @map("tech_tags")
  /// Sponsor challenges this submission has opted into. Free-standing ids
  /// rather than a join table: a team edits this the same way it edits tags.
  challengeIds String[] @default([]) @map("challenge_ids")
  license      String?

  /// Eligibility declarations ticked at submit time.
  declarations Json @default("{}")

  status      SubmissionStatus @default(DRAFT)
  submittedAt DateTime?        @map("submitted_at")
  /// Set when an organizer locks the entry. Combined with the event deadline
  /// this is what the server checks before allowing an edit.
  lockedAt    DateTime?        @map("locked_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  event Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  team  Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  track Track? @relation(fields: [trackId], references: [id], onDelete: SetNull)

  images           SubmissionImage[]
  answers          CustomAnswer[]
  assignments      JudgeAssignment[]
  scores           JudgeScore[]
  normalizedScores NormalizedScore[]
  votes            Vote[]
  comments         Comment[]

  @@index([eventId, status])
  @@map("submissions")
}

model SubmissionImage {
  id           String  @id @default(uuid()) @db.Uuid
  submissionId String  @map("submission_id") @db.Uuid
  url          String
  caption      String?
  position     Int     @default(0)

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@map("submission_images")
}

enum QuestionType {
  SHORT_TEXT
  LONG_TEXT
  URL
  SELECT
  MULTI_SELECT
  BOOLEAN
}

/// Where an organizer's question is asked.
enum QuestionStage {
  REGISTRATION
  SUBMISSION
}

model CustomQuestion {
  id       String        @id @default(uuid()) @db.Uuid
  eventId  String        @map("event_id") @db.Uuid
  stage    QuestionStage @default(SUBMISSION)
  prompt   String
  helpText String?      @map("help_text")
  type     QuestionType @default(LONG_TEXT)
  options  String[]     @default([])
  required Boolean      @default(false)
  /// Shown in the public gallery, or only to judges and organizers.
  publicAnswer Boolean  @default(true) @map("public_answer")
  position Int          @default(0)

  event   Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  answers CustomAnswer[]

  @@index([eventId])
  @@map("custom_questions")
}

model CustomAnswer {
  id           String @id @default(uuid()) @db.Uuid
  submissionId String @map("submission_id") @db.Uuid
  questionId   String @map("question_id") @db.Uuid
  value        String

  submission Submission     @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question   CustomQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, questionId])
  @@map("submission_custom_answers")
}

// ============================================================
// Judging
// ============================================================

enum JudgingMode {
  RUBRIC
  COMPARATIVE
}

model Rubric {
  id      String      @id @default(uuid()) @db.Uuid
  eventId String      @unique @map("event_id") @db.Uuid
  name    String      @default("Default rubric")
  mode    JudgingMode @default(RUBRIC)
  /// Comparative mode: how many projects a judge ranks per group (2-6).
  groupSize Int       @default(4) @map("group_size")
  /// Frozen once scoring starts, so a weight cannot change underneath ballots
  /// that were already cast.
  lockedAt DateTime?  @map("locked_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  event    Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  criteria RubricCriterion[]

  @@map("rubrics")
}

model RubricCriterion {
  id       String  @id @default(uuid()) @db.Uuid
  rubricId String  @map("rubric_id") @db.Uuid
  key      String
  label    String
  hint     String?
  /// Integer percentage. The service layer enforces that weights sum to 100.
  weight   Int
  minScore Int     @default(1) @map("min_score")
  maxScore Int     @default(5) @map("max_score")
  position Int     @default(0)

  rubric      Rubric           @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  scoreValues CriterionScore[]

  @@unique([rubricId, key])
  @@map("rubric_criteria")
}

model JudgeAssignment {
  id           String @id @default(uuid()) @db.Uuid
  eventId      String @map("event_id") @db.Uuid
  judgeId      String @map("judge_id") @db.Uuid
  submissionId String @map("submission_id") @db.Uuid

  /// Stable per-judge queue order, randomized at assignment time to blunt
  /// position bias.
  position   Int       @default(0)
  skippedAt  DateTime? @map("skipped_at")
  skipReason String?   @map("skip_reason")

  createdAt DateTime @default(now()) @map("created_at")

  event      Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  judge      User       @relation(fields: [judgeId], references: [id], onDelete: Cascade)
  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  /// A judge is never assigned the same project twice.
  @@unique([judgeId, submissionId])
  @@index([eventId, judgeId])
  @@index([eventId, submissionId])
  @@map("judge_assignments")
}

/// One ballot: one judge's evaluation of one submission.
model JudgeScore {
  id           String @id @default(uuid()) @db.Uuid
  eventId      String @map("event_id") @db.Uuid
  judgeId      String @map("judge_id") @db.Uuid
  submissionId String @map("submission_id") @db.Uuid

  /// Weighted total on a 0-100 scale, computed server-side from the criterion
  /// values and the rubric weights. Never accepted from the client.
  weightedTotal Float   @map("weighted_total")
  comment       String?

  submittedAt DateTime @default(now()) @map("submitted_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  event           Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  judge           User             @relation(fields: [judgeId], references: [id], onDelete: Cascade)
  submission      Submission       @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  criterionScores CriterionScore[]

  @@unique([judgeId, submissionId])
  @@index([eventId, submissionId])
  @@index([eventId, judgeId])
  @@map("judge_scores")
}

model CriterionScore {
  id          String @id @default(uuid()) @db.Uuid
  scoreId     String @map("score_id") @db.Uuid
  criterionId String @map("criterion_id") @db.Uuid
  value       Int

  score     JudgeScore      @relation(fields: [scoreId], references: [id], onDelete: Cascade)
  criterion RubricCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@unique([scoreId, criterionId])
  @@map("criterion_scores")
}

enum NormalizationMethod {
  RAW
  ZSCORE
  RANK_AVERAGE
}

/// An immutable snapshot of a ranking computation, so any published result can
/// be reproduced and audited after the fact.
/// One finished comparative ranking: a judge's order over one group of
/// projects. Unique per (event, judge, group), so re-ranking a group replaces
/// the previous order rather than stacking a second one.
model PairwiseRanking {
  id       String  @id @default(uuid()) @db.Uuid
  eventId  String  @map("event_id") @db.Uuid
  judgeId  String  @map("judge_id") @db.Uuid
  groupKey String  @map("group_key")
  /// Submission ids, best to worst.
  order    String[]
  skipped  Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  judge User  @relation("PairwiseJudge", fields: [judgeId], references: [id], onDelete: Cascade)

  @@unique([eventId, judgeId, groupKey])
  @@index([eventId])
  @@map("pairwise_rankings")
}

model NormalizationRun {
  id      String              @id @default(uuid()) @db.Uuid
  eventId String              @map("event_id") @db.Uuid
  method  NormalizationMethod
  /// Per-judge statistics (n, mean, sd) captured at run time.
  judgeStats Json             @map("judge_stats")
  /// Rubric weights and run configuration captured at run time.
  parameters Json             @default("{}")
  ballotCount Int             @map("ballot_count")
  /// SHA-256 of the ballots the run read; publication is refused once they no longer match.
  ballotDigest String?        @map("ballot_digest")
  createdAt  DateTime         @default(now()) @map("created_at")

  event       Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  scores      NormalizedScore[]
  publishedBy Event?            @relation("PublishedRun")

  @@index([eventId, createdAt])
  @@map("normalization_runs")
}

model NormalizedScore {
  id           String @id @default(uuid()) @db.Uuid
  runId        String @map("run_id") @db.Uuid
  submissionId String @map("submission_id") @db.Uuid

  rawMean         Float @map("raw_mean")
  normalizedValue Float @map("normalized_value")
  rawRank         Int   @map("raw_rank")
  normalizedRank  Int   @map("normalized_rank")
  ballotCount     Int   @map("ballot_count")

  run        NormalizationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  submission Submission       @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([runId, submissionId])
  @@map("normalized_scores")
}

// ============================================================
// Community voting and comments
// ============================================================

enum VotingAccess {
  OPEN_LINK
  EMAIL_GATED
  AUTHENTICATED
}

enum VotingMethod {
  SINGLE
  QUADRATIC
}

model VotingConfig {
  id      String       @id @default(uuid()) @db.Uuid
  eventId String       @unique @map("event_id") @db.Uuid
  enabled Boolean      @default(false)
  access  VotingAccess @default(AUTHENTICATED)
  method  VotingMethod @default(SINGLE)
  /// Quadratic credit budget per voter.
  creditBudget Int     @default(100) @map("credit_budget")
  /// Hide tallies from everyone but organizers until the window closes.
  hideResults   Boolean @default(true) @map("hide_results")
  /// Randomize ballot ordering per voter, to kill position bias.
  shuffleBallot Boolean @default(true) @map("shuffle_ballot")
  /// Who may cast community votes. Visitors hold no role in the event (signed in or not);
  /// a person holding several roles may vote only if every role they hold is allowed.
  allowVisitors     Boolean @default(true) @map("allow_visitors")
  allowParticipants Boolean @default(true) @map("allow_participants")
  allowJudges       Boolean @default(false) @map("allow_judges")
  allowAdmins       Boolean @default(false) @map("allow_admins")

  /// Open-link voting: distinct voters one address may add per hour.
  maxVotesPerIpPerHour Int @default(60) @map("max_votes_per_ip_per_hour")
  /// SINGLE only: how many projects one voter may back. One (the default) is a normal poll, one person
  /// one vote; null means any number (approval voting).
  maxChoices Int? @default(1) @map("max_choices")
  /// Whether a voter may change their vote until the poll closes. Off makes the first ballot final.
  allowVoteChange Boolean @default(true) @map("allow_vote_change")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("voting_configs")
}

/// Proof that an email-gated voter controls their address: a one-time code, then a voter token.
model VoterVerification {
  id         String    @id @default(uuid()) @db.Uuid
  eventId    String    @map("event_id") @db.Uuid
  email      String
  codeHash   String    @map("code_hash")
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at")
  verifiedAt DateTime? @map("verified_at")
  tokenHash  String?   @unique @map("token_hash")
  ipHash     String?   @map("ip_hash")
  createdAt  DateTime  @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, email])
  @@map("voter_verifications")
}

model Vote {
  id           String @id @default(uuid()) @db.Uuid
  eventId      String @map("event_id") @db.Uuid
  submissionId String @map("submission_id") @db.Uuid

  /// Depending on the event's access mode the voter is identified by account
  /// or by verified email. `voterKey` is the canonical identity used for
  /// uniqueness in every mode.
  userId     String? @map("user_id") @db.Uuid
  voterEmail String? @map("voter_email")
  voterKey   String  @map("voter_key")

  /// Votes placed on this submission by this voter.
  weight  Int @default(1)
  /// Credits spent. Under quadratic voting this is weight squared.
  credits Int @default(1)

  ipHash        String?  @map("ip_hash")
  userAgentHash String?  @map("user_agent_hash")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  event      Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// One ballot line per voter per submission: duplicate detection lives in
  /// the database, not in application code.
  @@unique([eventId, submissionId, voterKey])
  @@index([eventId, voterKey])
  @@map("votes")
}

model Comment {
  id           String    @id @default(uuid()) @db.Uuid
  eventId      String    @map("event_id") @db.Uuid
  submissionId String    @map("submission_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  body         String
  hiddenAt     DateTime? @map("hidden_at")
  hiddenReason String?   @map("hidden_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  event      Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([submissionId, createdAt])
  @@map("comments")
}

// ============================================================
// Operations
// ============================================================

enum UpdateTag {
  ROUNDS
  DEADLINE
  JUDGING
  LOGISTICS
  VOTING
}

model EventUpdate {
  id        String    @id @default(uuid()) @db.Uuid
  eventId   String    @map("event_id") @db.Uuid
  authorId  String    @map("author_id") @db.Uuid
  title     String
  body      String
  tag       UpdateTag @default(LOGISTICS)
  pinned    Boolean   @default(false)
  createdAt DateTime  @default(now()) @map("created_at")

  event  Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  author User         @relation("UpdateAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  reads  UpdateRead[]

  @@index([eventId, createdAt])
  @@map("event_updates")
}

/// An organizer-configured outbound notification. Payloads are signed with
/// HMAC-SHA256 over the raw body using `secret`, so the receiver can prove a
/// call came from this instance.
model Webhook {
  id        String   @id @default(uuid()) @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  url       String
  secret    String
  /// Audit actions this hook subscribes to.
  events    String[]
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  event      Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]
  outbox     WebhookOutbox[]

  @@index([eventId])
  @@map("webhooks")
}

enum WebhookOutboxStatus {
  PENDING
  DELIVERED
  FAILED
}

/// One notification owed to one webhook. Its id is the delivery id receivers deduplicate on;
/// it is retried with backoff until delivered or out of attempts.
model WebhookOutbox {
  id            String              @id @default(uuid()) @db.Uuid
  webhookId     String              @map("webhook_id") @db.Uuid
  action        String
  body          String
  status        WebhookOutboxStatus @default(PENDING)
  attempts      Int                 @default(0)
  nextAttemptAt DateTime            @default(now()) @map("next_attempt_at")
  lastError     String?             @map("last_error")
  deliveredAt   DateTime?           @map("delivered_at")
  createdAt     DateTime            @default(now()) @map("created_at")

  webhook  Webhook           @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  attemptLog WebhookDelivery[]

  @@index([status, nextAttemptAt])
  @@index([webhookId, createdAt])
  @@map("webhook_outbox")
}

/// One delivery attempt.
model WebhookDelivery {
  id         String   @id @default(uuid()) @db.Uuid
  webhookId  String   @map("webhook_id") @db.Uuid
  outboxId   String?  @map("outbox_id") @db.Uuid
  attempt    Int      @default(1)
  action     String
  statusCode Int?     @map("status_code")
  ok         Boolean  @default(false)
  error      String?
  durationMs Int?     @map("duration_ms")
  createdAt  DateTime @default(now()) @map("created_at")

  webhook Webhook        @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  outbox  WebhookOutbox? @relation(fields: [outboxId], references: [id], onDelete: Cascade)

  @@index([webhookId, createdAt])
  @@map("webhook_deliveries")
}

enum Experience {
  FIRST_EVENT
  A_FEW
  MANY
}

/// What a participant told the organizer when registering. One per person per
/// event; the event membership itself stays the authorization record.
model Registration {
  id           String      @id @default(uuid()) @db.Uuid
  eventId      String      @map("event_id") @db.Uuid
  userId       String      @map("user_id") @db.Uuid
  currentRole  String?     @map("current_role")
  experience   Experience?
  skills       String[]    @default([])
  trackId      String?     @map("track_id") @db.Uuid
  shareProfile Boolean     @default(false) @map("share_profile")
  /// Answers to REGISTRATION-stage questions, keyed by question id.
  answers      Json        @default("{}")
  rulesAcceptedAt   DateTime @map("rules_accepted_at")
  conductAcceptedAt DateTime @map("conduct_accepted_at")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@map("registrations")
}

/// A read receipt: which account has opened which announcement.
model UpdateRead {
  updateId String   @map("update_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  readAt   DateTime @default(now()) @map("read_at")

  update EventUpdate @relation(fields: [updateId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([updateId, userId])
  @@map("update_reads")
}

/// Append-only and hash-chained per event, both enforced by database triggers (migration 0017).
model AuditLog {
  id      String  @id @default(uuid()) @db.Uuid
  eventId String? @map("event_id") @db.Uuid
  actorId String? @map("actor_id") @db.Uuid

  action     String
  targetType String? @map("target_type")
  targetId   String? @map("target_id")
  /// Human-readable one-liner, so an organizer can read the trail without a
  /// database client.
  summary  String
  metadata Json    @default("{}")

  ipHash    String?  @map("ip_hash")
  createdAt DateTime @default(now()) @map("created_at")

  /// Written by the insert trigger: position in the chain, the previous entry's hash, and this one's.
  chainSeq Int?    @map("chain_seq")
  prevHash String? @map("prev_hash")
  hash     String?

  event Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)
  actor User?  @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([eventId, createdAt])
  @@index([eventId, chainSeq])
  @@index([action])
  @@map("audit_logs")
}
