# Copy to .env for docker compose, or to src/server/.env for local development.
# Every value here has a working default in docker-compose.yml, so
# `docker compose up` works with no .env file at all.

# --- Postgres ---
POSTGRES_USER=podium
POSTGRES_PASSWORD=podium
POSTGRES_DB=podium
# Host port for the database. 5433 to avoid clashing with a local Postgres.
POSTGRES_PORT=5433

# --- API ---
API_PORT=4000
# Local development (outside Docker) points at the published host port.
DATABASE_URL=postgresql://podium:podium@localhost:5433/podium?schema=public
# Optional. Left empty, the API generates both secrets on first boot and stores them in the
# database. Set them (at least 32 characters, e.g. openssl rand -hex 32) to manage them yourself.
# Record signing is separate so rotating sessions never invalidates issued judge records.
JWT_SECRET=
RECORD_SIGNING_SECRET=
JWT_EXPIRES_IN=7d
# Set true behind HTTPS.
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:3000
# Leave false when the API port is published directly. Behind a reverse proxy, set the
# hop count (1) or the proxy's address, so rate limits see the real client IP.
TRUST_PROXY=false
# memory (one API container) or postgres (several replicas share limits through the database).
RATE_LIMIT_STORE=memory
# Local development only: let webhooks reach private and loopback addresses.
WEBHOOK_ALLOW_PRIVATE=false

# Seed demo data and fixtures.json on boot. Demo accounts share a public password, so set
# false for a real event.
SEED_ON_BOOT=true
# Issue the acceptance checker's public tokens (scoped to the fixture event only).
FIXTURE_TOKENS=true

# --- Web client ---
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000
