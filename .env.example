# Copy to .env for docker compose, or to src/server/.env for local development.
# Every value here has a working default in docker-compose.yml, so
# `docker compose up` works with no .env file at all.

# --- Postgres ---
POSTGRES_USER=podium
POSTGRES_PASSWORD=podium
POSTGRES_DB=podium
# Host port for the database. 5433 to avoid clashing with a local Postgres.
POSTGRES_PORT=5433

# --- API ---
API_PORT=4000
# Local development (outside Docker) points at the published host port.
DATABASE_URL=postgresql://podium:podium@localhost:5433/podium?schema=public
# Must be at least 32 characters. Generate: openssl rand -hex 32
JWT_SECRET=dev-only-change-me-in-production-0123456789abcdef
JWT_EXPIRES_IN=7d
# Set true behind HTTPS.
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:3000
# Run the fixture seed on API boot if the database is empty.
SEED_ON_BOOT=true

# --- Web client ---
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000
